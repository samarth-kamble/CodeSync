{
  "manifest_version": 3,
  "name": "CodeSync - LeetCode to GitHub",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "description": "Automatically synchronize accepted LeetCode coding solutions to your GitHub repository.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "CodeSync"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://leetcode.com/problems/*",
        "*://*.leetcode.com/problems/*",
        "*://*.geeksforgeeks.org/problems/*",
        "*://practice.geeksforgeeks.org/problems/*",
        "*://*.hackerrank.com/challenges/*",
        "*://*.hackerrank.com/contests/*/challenges/*"
      ],
      "js": ["src/content/interceptor.iife.ts"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://leetcode.com/problems/*",
        "*://*.leetcode.com/problems/*",
        "*://*.geeksforgeeks.org/problems/*",
        "*://practice.geeksforgeeks.org/problems/*",
        "*://*.hackerrank.com/challenges/*",
        "*://*.hackerrank.com/contests/*/challenges/*"
      ],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "notifications",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://*.leetcode.com/*",
    "https://*.geeksforgeeks.org/*",
    "https://practiceapi.geeksforgeeks.org/*",
    "https://*.hackerrank.com/*",
    "https://api.github.com/*"
  ]
}
